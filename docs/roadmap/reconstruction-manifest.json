  "amendments": [
    {
      "id": "K01",
      "title": "Early public provider compatibility",
      "packages": [
        "M00-03",
        "M00-05",
        "M02-06",
        "M11-02"
      ],
      "rule": "Check permitted integration/distribution paths early, confirm critical authentication feasibility in M02 and recheck public distribution in M11."
    },
    {
      "id": "K02",
      "title": "Authenticated Linux inference gate",
      "packages": [
        "M02-06",
        "M02-13",
        "M02-15"
      ],
      "rule": "Require real authenticated Linux agent execution with protected account boundary and verified sandbox before M02 acceptance."
    },
    {
      "id": "K03",
      "title": "Early central quota guard",
      "packages": [
        "M02-06",
        "M02-12",
        "M04-10",
        "M05-10",
        "M07-06"
      ],
      "rule": "All inference routes use one minimal guard from M02, expanded in M05/M07; unknown quota holds automation."
    },
    {
      "id": "K04",
      "title": "Parallelization dependency",
      "packages": [
        "M05-09",
        "M05-10"
      ],
      "rule": "Make M05-10 an explicit prerequisite of M05-09. Before guard completion, use fake providers or explicitly controlled single runs."
    },
    {
      "id": "K05",
      "title": "Separate domain states",
      "packages": [
        "M03-07",
        "M04-03",
        "M05-01",
        "M06-08",
        "M08-06"
      ],
      "rule": "Separate project/task, agent/session/run, quality and external sync states; run success is not task completion."
    },
    {
      "id": "K06",
      "title": "Protected Git metadata",
      "packages": [
        "M02-09",
        "M06-10",
        "M06-12"
      ],
      "rule": "Protect shared config, hooks and refs; bind integration approval to source/target commits; reconcile uncertain writes."
    },
    {
      "id": "K07",
      "title": "Linux/Windows boundary",
      "packages": [
        "M02-08",
        "M02-10",
        "M02-14"
      ],
      "rule": "Test interop, host IPC, mounts, credentials and broker; disable unsupported/unsafe paths."
    },
    {
      "id": "K08",
      "title": "Trusted quality evidence",
      "packages": [
        "M06-02",
        "M06-04",
        "M06-06",
        "M06-07"
      ],
      "rule": "Protected test definitions, trusted execution capture and candidate identity; independently authorize test baseline changes."
    },
    {
      "id": "K09",
      "title": "Stop semantics",
      "packages": [
        "M02-11",
        "M05-13",
        "M09-10"
      ],
      "rule": "Separate Pause New Starts, Cancel Run and Emergency Stop; persist global stop; track descendant termination and external effects separately."
    },
    {
      "id": "K10",
      "title": "Cumulative budgets",
      "packages": [
        "M04-10",
        "M05-12",
        "M06-09",
        "M07-09"
      ],
      "rule": "Central persistent counters; retries, session/model changes and restart must not reset budgets implicitly."
    },
    {
      "id": "K11",
      "title": "Backup retention safety",
      "packages": [
        "M07-11",
        "M11-09"
      ],
      "rule": "Retention and size are targets; protect last verified restore basis and required migration backups; warn/block updates on insufficient space."
    },
    {
      "id": "K12",
      "title": "Sync guarantees",
      "packages": [
        "M08-07",
        "M08-09",
        "M08-11"
      ],
      "rule": "Preflight and post-write verification; block ambiguous effects; document residual non-atomic race risk."
    },
    {
      "id": "K13",
      "title": "Update trust",
      "packages": [
        "M11-04",
        "M11-05",
        "M11-08",
        "M11-09"
      ],
      "rule": "Bind versions and artifacts, plan key rotation/revocation and downgrade protection; distinguish Windows code signing."
    },
    {
      "id": "K14",
      "title": "External field authority",
      "packages": [
        "M12-03",
        "M12-13"
      ],
      "rule": "One authority per synchronized field or explicit conflict rule; prevent synchronization loops."
    },
    {
      "id": "K15",
      "title": "MCP server trust",
      "packages": [
        "M12-04",
        "M12-05"
      ],
      "rule": "Isolate local server processes, constrain external data transfers, deny unknown tools by default."
    },
    {
      "id": "K16",
      "title": "Semantic index scope",
      "packages": [
        "M12-10",
        "M12-11"
      ],
      "rule": "Enforce scope during indexing and candidate selection, including deletion, reindexing, model versions and external transfer."
    },
    {
      "id": "K17",
      "title": "Distributed leases",
      "packages": [
        "M13-11",
        "M13-12",
        "M13-13"
      ],
      "rule": "Use versioned leases/fencing for supported integration effects; reject stale results and block unresolvable side effects."
    },
    {
      "id": "K18",
      "title": "Pre-release ecosystem validation",
      "packages": [
        "M13-05",
        "M13-06",
        "M13-17",
        "M13-18"
      ],
      "rule": "Validate release candidates before publication; conditional dependencies per release; platform-specific plugin isolation checks."
    }
  ],
